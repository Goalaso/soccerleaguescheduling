DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
JWT_SECRET=replace-with-a-random-32-plus-byte-string
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
# Optional locally — only needed to exercise outbound/inbound email features
# against the real /bisl/outlook-email SSM parameter (requires AWS credentials).
OUTLOOK_SECRET_PARAM=/bisl/outlook-email
