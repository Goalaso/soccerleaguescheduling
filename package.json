{
  "name": "soccer-league-scheduling",
  "version": "1.0.0",
  "description": "A React application for managing soccer league schedules",
  "main": "index.js",
  "proxy": "http://localhost:4000",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "npm --prefix server run dev",
    "dev": "concurrently \"npm start\" \"npm run server\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "react-scripts": "5.0.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
